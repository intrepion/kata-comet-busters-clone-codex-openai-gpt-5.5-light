{
  "name": "meteor-breakers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:direct": "node scripts/build-direct.mjs",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:file": "playwright test --config playwright.file.config.ts",
    "check": "npm run build && npm run test && npm run test:e2e && npm run build:direct && npm run test:file"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
